CALIBRAI_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/calibrai
CALIBRAI_ENVIRONMENT=development
CALIBRAI_API_ORIGINS=https://chatgpt.com,https://claude.ai,https://gemini.google.com,http://localhost:5173,chrome-extension://replace-with-extension-id
CALIBRAI_CONSENT_VERSION=2026-11-04
CALIBRAI_RATE_LIMIT_REQUESTS=60
CALIBRAI_RATE_LIMIT_WINDOW_SECONDS=60
CALIBRAI_MAX_REQUEST_BYTES=65536
CALIBRAI_SESSION_SIGNING_SECRET=replace-with-a-random-32-character-or-longer-secret
CALIBRAI_SESSION_TTL_SECONDS=900
CALIBRAI_ENROLLMENT_SECRET=replace-with-a-server-only-enrollment-secret
