# Copy to .env.local and adjust. All values end up in the public bundle: none of them is a secret.
# The API the harness talks to.
VITE_API_BASE_URL=http://127.0.0.1:8000
# The consent text version shown on the consent page; must equal CALIBRAI_CONSENT_VERSION on the API.
VITE_CONSENT_VERSION=2026-11-04
# Optional fallback for the enrollment code when the study link has no ?code= parameter.
VITE_STUDY_ENROLLMENT_CODE=
# 1 = run the whole flow without a backend (demos). Nothing is saved.
VITE_DEMO=0
