{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@calibrai/*": ["../../src/*"],
      "@study-data/*": ["../../data/*"],
      "@contracts/*": ["../../contracts/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
